# 🔐 Environment Configuration Template
# Copy this file to .env and update with your values

# Database Configuration
# Default: MongoDB running locally on port 27017
MONGODB_URI=mongodb://localhost:27017/hybrid-library

# JWT Configuration
# IMPORTANT: Generate a strong random string at least 32 characters
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_key_min_32_chars_change_this_in_production

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration (for CORS)
CLIENT_URL=http://localhost:5173

# Email Configuration
EMAIL_USER=nivethasuresh090@gmail.com
EMAIL_PASS=erhx irwa afmn jlrb

# Optional: File Upload Configuration
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=5242880

# Optional: Geolocation Configuration
# GEOLOCATION_RADIUS_KM=5
# DEFAULT_LOCATION_LAT=12.9716
# DEFAULT_LOCATION_LNG=77.5946

# Optional: Session Configuration
# SESSION_SECRET=session_secret_key_change_this
# SESSION_TIMEOUT=86400000

# Optional: Debugging
# DEBUG=app:*
# LOG_LEVEL=debug
